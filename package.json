{
  "name": "book-series-tracker",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:cloudflare": "VITE_BASE_PATH=/ npm run build",
    "pages:dev": "npm run build:cloudflare && wrangler pages dev dist",
    "pages:deploy": "npm run build:cloudflare && wrangler pages deploy dist --project-name book-series-tracker",
    "preview": "vite preview --host 0.0.0.0",
    "verify:prod-smoke": "node scripts/prod-smoke.mjs",
    "verify": "npm run build && node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.2.2",
    "typescript": "^5.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "playwright-core": "^1.61.0",
    "wrangler": "^4.127.1"
  }
}
